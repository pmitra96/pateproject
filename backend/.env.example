# --- WhatsApp Agent Configuration ---

# Meta API Credentials
WHATSAPP_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# AI Model Configuration
PREFERRED_LLM_MODEL=gpt-4o-mini # Options: gpt-4o, gpt-4o-mini, etc.
OPENAI_API_KEY=your_openai_key_here

# Guardrails & Limits
WHATSAPP_DAILY_LIMIT=50        # Max AI messages per user per day
WHATSAPP_HISTORY_WINDOW=20     # Number of previous messages to include in context

# Database (Neon Postgres)
DATABASE_URL=postgres://user:pass@host:port/dbname?sslmode=require

# App Environment
PORT=8080
ENV=development # development | production
